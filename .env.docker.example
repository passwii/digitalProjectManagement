# Docker 只运行 api + web，不启动数据库。
# 连接到宿主机 PostgreSQL（macOS/Windows Docker Desktop 可直接使用 host.docker.internal）。
DATABASE_URL=postgresql+psycopg://oa_user:change_me@host.docker.internal:5432/oa_platform
DATA_VOLUME=pm-pg-data

# 前端统一使用 3001，后端统一使用 8001。
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---------------- 生产 HTTPS 入口（BLF-1400）----------------
# ⚠️ 这一段**只对生产**有意义（本地开发不需要）。
#
# 为什么生产必须有 HTTPS：PWA 只能装在**安全上下文**里。Chrome 只在
# HTTPS（或 localhost）下给 navigator.serviceWorker；没有 SW 就拿不到
# WebAPK，只能降级成「快捷方式」安装 —— 主屏幕图标右下角会挂一个
# **Chrome 徽标**，而且装出来的不是真应用（没有应用抽屉入口、没有独立包名）。
# 实测（Chrome 140，http://<裸 IP>:3001）：isSecureContext=false、
# navigator.serviceWorker=undefined、installability_errors=not-from-secure-origin。
#
# 生产使用宿主机上的 Caddy 终止 HTTPS（公网域名：oa.zikert.com），
# Web/API 容器端口仅绑定到回环，由宿主机 Caddy 反代。
# PM_DOMAIN 用于生成浏览器 API 基址与 CORS 源；必须与宿主机 Caddy 域名一致。
PM_DOMAIN=oa.zikert.com
# 宿主机上 web 端口的绑定地址：生产固定 127.0.0.1，由 Caddy 反代。
PM_HOST_BIND=127.0.0.1
# 宿主机上 api 端口的绑定地址：同上。
API_PORT_BIND=127.0.0.1
# 前端构建期编进产物的 API 基址：生产必须与 PM_DOMAIN 同源。
# 留空时生产 Compose 会从 PM_DOMAIN 生成 https://oa.zikert.com/api/v1。
NEXT_PUBLIC_API_BASE=

# ---------------- 附件对象存储：Cloudflare R2（BLF-1136） ----------------
# 口径：**R2 是附件正文唯一的持久化存储**；服务器磁盘只允许上传途中短暂停留。
# STORAGE_BACKEND 决定**新上传**落到哪里：r2 / auto / local
#   r2    （默认）—— 新上传强制走对象存储；R2_* 配不全时**应用启动即失败**。
#   auto          —— R2_* 配齐就走 R2；配不齐同样**启动即失败**（不静默回落本地盘）。
#   local         —— 仅开发/测试：正文写进 STORAGE_LOCAL_ROOT（默认系统临时目录），
#                    **不持久化**；APP_ENV=production 时该取值被拒绝。
# 以上只是**新写入**的落点：已存在附件仍按行内 storage_backend 读/删。
#
# 不带 R2 凭据的本地开发，请改成：STORAGE_BACKEND=local
STORAGE_BACKEND=r2
# 运行环境：development / production（生产环境禁止本地后端）
APP_ENV=development
# 本地后端暂存目录（留空 = 系统临时目录）。**不许指向应用目录**（含 data 持久卷）。
STORAGE_LOCAL_ROOT=

# R2 凭据与桶（Cloudflare 控制台的 R2 API Token 页获取；这些东西是机密）。
# 下面四项齐全才算配置完整。R2_ACCOUNT_ID 仅供人工记录，代码不读取（endpoint 已含账号）。
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# 自定义公开域名（配了就用它拼 URL）；不需要公共读就留空，下载仍走 API 鉴权代理。
R2_PUBLIC_URL=
# 预签名直读 URL 的有效期（秒），默认 3600。
R2_PRESIGN_TTL_SECONDS=3600
