# Docker 只运行 api + web，不启动数据库。
# 连接到宿主机 PostgreSQL（macOS/Windows Docker Desktop 可直接使用 host.docker.internal）。
DATABASE_URL=postgresql+psycopg://oa_user:change_me@host.docker.internal:5432/oa_platform
DATA_VOLUME=pm-pg-data

# 前端统一使用 3001，后端统一使用 8001。
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---------------- 附件对象存储：Cloudflare R2（BLF-1136） ----------------
# STORAGE_BACKEND 决定**新上传**落到哪里：auto / local / r2
#   auto （默认）—— R2_* 配齐就用 R2，否则回落本地磁盘（会记 warning）；本地开发与 CI 不必配凭据。
#   r2           —— 新上传强制走对象存储；配置不全时**应用启动即失败**（不会绿着起来）。
#   local        —— 新上传落本地磁盘。注意：**不是整体回滚开关**，已上 R2 的存量附件
#                   仍按行内 storage_backend 从 R2 读/删（下载、删除都不受影响）。
STORAGE_BACKEND=auto

# R2 凭据与桶（Cloudflare 控制台的 R2 API Token 页获取；这些东西是机密）。
# 下面四项齐全才算配置完整。R2_ACCOUNT_ID 仅供人工记录，代码不读取（endpoint 已含账号）。
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# 自定义公开域名（配了就用它拼 URL）；不需要公共读就留空，下载仍走 API 鉴权代理。
R2_PUBLIC_URL=
# 预签名直读 URL 的有效期（秒），默认 3600。
R2_PRESIGN_TTL_SECONDS=3600
