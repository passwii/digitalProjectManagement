{
  "name": "project-mgmt-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "test": "npm run test:unit && npm run test:motion",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-dist/lib/",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "next lint",
    "test:motion": "vitest run",
    "mock:generate": "node ../scripts/mock/generate.mjs",
    "mock:validate": "node ../scripts/mock/validate.mjs",
    "mock:audit": "node ../scripts/mock/audit-frontend-contract.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "9.2.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
